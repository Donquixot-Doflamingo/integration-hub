{
	"name": "integration-hub-console",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Integration Hub admin console (control plane UI, F-19).",
	"engines": {
		"node": ">=22 <23"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
		"lint": "prettier --check . && eslint . && node scripts/check-api-types.mjs",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"gen:api": "openapi-typescript ../contracts/openapi/hub-admin.v1.yaml -o src/lib/api/schema.d.ts --empty-objects-unknown --default-non-nullable=false && node scripts/extract-examples.mjs && node scripts/extract-roles.mjs",
		"dev:mock": "HUB_API_MOCKING=true vite dev",
		"build:mock": "HUB_API_MOCKING=true vite build"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "22.20.5",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jsdom": "30.1.3",
		"msw": "3.0.3",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"openapi-fetch": "0.17.0",
		"yaml": "2.9.1"
	}
}
