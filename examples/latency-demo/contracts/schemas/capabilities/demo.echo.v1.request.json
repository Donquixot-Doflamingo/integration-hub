{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hub:capability:demo.echo@v1:default:request",
  "title": "demo.echo@v1 request (EXAMPLE ONLY, not a frozen contract)",
  "description": "Example capability for examples/latency-demo (HUB-353): send a small message and get it back from an echo service. Not part of contracts/.",
  "x-capability": "demo.echo@v1",
  "x-capability-minor": 0,
  "interactive": false,
  "operations": {
    "default": {
      "description": "Echo a message.",
      "idempotent": true,
      "request_schema": "demo.echo.v1.request.json",
      "response_schema": "demo.echo.v1.response.json"
    }
  },
  "type": "object",
  "required": ["message"],
  "additionalProperties": false,
  "properties": {
    "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "seq": { "type": "integer", "minimum": 0 }
  },
  "examples": [
    { "message": "hello", "seq": 1 }
  ]
}
