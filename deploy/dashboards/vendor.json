      "type": "timeseries",
      "title": "Vendor latency p99 by outcome",
      "description": "Outcome is the status class (2xx..5xx) or the transport failure (timeout, connect, reset, canceled, protocol).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, outcome) (rate(vendor_latency_ms_bucket{vendor=\"$vendor\", account=~\"$account\", endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "range": true,
          "legendFormat": "{{outcome}}",
          "editorMode": "code",
          "exemplar": true
