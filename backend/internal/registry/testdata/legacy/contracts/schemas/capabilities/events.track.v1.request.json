{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hub:capability:events.track@v1:default:request",
  "title": "events.track@v1 request",
  "description": "Canonical request for tracking one user event with an engagement/analytics tool. Vendor-agnostic: no field names a vendor. Minor version 1.0.",
  "x-capability": "events.track@v1",
  "x-capability-minor": 0,
  "interactive": false,
  "operations": {
    "default": {
      "description": "Track a single event for a user.",
      "idempotent": true,
      "request_schema": "events.track.v1.request.json",
      "response_schema": "events.track.v1.response.json"
    }
  },
  "type": "object",
  "required": ["user", "event"],
  "additionalProperties": false,
  "properties": {
    "user": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable identifier of the end user in the caller's system. Used as the subject identifier for PII deletion.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-pii": "identifier"
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Event name, snake_case recommended.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "timestamp": {
          "description": "When the event happened (RFC 3339). Defaults to the Hub receive time if omitted.",
          "type": "string",
          "format": "date-time"
        },
        "properties": {
          "description": "Free-form event properties (flat or nested JSON). Do not put PII here unless the integration's audit policy allows it; values here are treated as `free_text` for masking.",
          "type": "object",
          "maxProperties": 256,
          "x-pii": "free_text"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "campaign": {
          "description": "Marketing campaign attribution. Transformers may default it (e.g. to \"organic\").",
          "type": "string",
          "maxLength": 128
        }
      }
    }
  },
  "examples": [
    {
      "user": { "id": "u_48213" },
      "event": {
        "name": "order_placed",
        "timestamp": "2026-10-31T09:15:00Z",
        "properties": { "order_id": "ord_8821", "amount_minor": 129900, "currency": "INR" }
      },
      "context": { "campaign": "diwali_2026" }
    }
  ]
}
