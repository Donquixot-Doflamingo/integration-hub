{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hub:capability:test.two_step@v1:send:request",
  "title": "test.two_step@v1 send request (TEST ONLY, not a frozen contract)",
  "description": "Test fixture for HUB-343: a non-interactive capability with two operations on two vendor endpoints. Lives in internal/testkit/multiop, never in contracts/.",
  "x-capability": "test.two_step@v1",
  "x-capability-minor": 0,
  "interactive": false,
  "operations": {
    "send": {
      "description": "Send a code to mobile.",
      "idempotent": false,
      "request_schema": "test.two_step.v1.send.request.json",
      "response_schema": "test.two_step.v1.send.response.json"
    },
    "verify": {
      "description": "Verify the code the user typed.",
      "idempotent": true,
      "request_schema": "test.two_step.v1.verify.request.json",
      "response_schema": "test.two_step.v1.verify.response.json"
    }
  },
  "type": "object",
  "required": ["mobile"],
  "additionalProperties": false,
  "properties": {
    "mobile": { "type": "string", "pattern": "^\\+91[6-9][0-9]{9}$", "x-pii": "phone" }
  }
}
