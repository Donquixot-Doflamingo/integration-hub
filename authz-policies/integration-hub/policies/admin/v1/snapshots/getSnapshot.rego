package {__package_name__}

# Get snapshot metadata and diff summary
# operationId: getSnapshot
# GET /admin/v1/snapshots/{snapshot_version}  ·  x-required-role: viewer  ·  x-required-permission: HUB_PLATFORM:READ  ·  scope: platform
# GENERATED by scripts/gen-authz.mjs from contracts/openapi/hub-admin.v1.yaml (hub-admin 2.1.0).
# Hand edits may add conditions; `node scripts/gen-authz.mjs --check` fails when the path, permission or scope disagree with the contract.

match_getSnapshot if {
	regex.match(`^/admin/v1/snapshots/[^/]+$`, input.http.path)
	not regex.match(`^/admin/v1/snapshots/latest$`, input.http.path) # getLatestSnapshot: a static route shadows this one
}

permit["GET"][input.http.path] if {
	match_getSnapshot
	platform_can(["HUB_PLATFORM:READ"])
}

details["GET"][input.http.path] := {
	"operation": "getSnapshot",
	"permissions": ["HUB_PLATFORM:READ"],
	"role": "viewer",
	"scope": "platform",
	"machine_allowed": true,
	"actual_permissions": object.get(input.sub, "permissions", []),
} if match_getSnapshot
